{
  "name": "domain-driven-microservices",
  "version": "1.0.0",
  "description": "Domain-driven microservices project with Node.js backend and Angular frontend",
  "private": true,
  "workspaces": [
    "services/*",
    "frontend"
  ],
  "scripts": {
    "dev": "docker-compose up -d",
    "dev:build": "docker-compose up --build",
    "stop": "docker-compose down",
    "clean": "docker-compose down -v --remove-orphans",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "jest": "^29.6.0",
    "lint-staged": "^14.0.1",
    "prettier": "^3.0.0",
    "typescript": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.20.0",
    "npm": ">=10.0.0"
  }
}
